# Copiar como .env y rellenar (este fichero NO se sube a Git)

# Dominio de la app en Vercel (sin https://), p. ej. auipark.vercel.app
VERCEL_HOST=auipark.vercel.app

# Supabase → Connect → "Session pooler" (puerto 5432) con la contraseña de la BD
SUPABASE_DB_URL=postgresql://postgres.qlkwgwpkvflcwepmezbw:[YOUR-DATABASE-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Contraseña de la base de datos interna de Zabbix (inventar una)
ZABBIX_DB_PASSWORD=cambia_esta_contraseña

# Puertos del PC (cambiarlos si 80/443 están ocupados)
HTTP_PORT=80
HTTPS_PORT=443
ZABBIX_WEB_PORT=8081
